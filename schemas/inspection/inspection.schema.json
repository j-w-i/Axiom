{
  "$comment": "GENERATED by `cargo run -p axiom-protocol --example export_schema`. Do not edit. DRAFT.",
  "$defs": {
    "Accessibility": {
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Capabilities": {
      "description": "What an adapter can do. Sent once in `inspect/hello`. Consumers must\ndegrade gracefully on every `false`/`None`; nothing here is mandatory\nexcept `tree`.",
      "properties": {
        "accessibility": {
          "type": "boolean"
        },
        "adapter": {
          "$ref": "#/$defs/PeerInfo"
        },
        "framework": {
          "description": "Framework identifier: `dom`, `react`, `qml`, `flutter`, ...",
          "type": "string"
        },
        "frameworkVersion": {
          "description": "Detected framework/runtime version, if known.",
          "type": [
            "string",
            "null"
          ]
        },
        "highlight": {
          "description": "Can draw a highlight overlay on a node in the running app.",
          "type": "boolean"
        },
        "hitTest": {
          "description": "Can map a point to the top-most node itself (otherwise the daemon\nhit-tests against the last snapshot's bounds).",
          "type": "boolean"
        },
        "mutations": {
          "description": "Emits `inspect/didMutate`.",
          "type": "boolean"
        },
        "properties": {
          "type": "boolean"
        },
        "screenshot": {
          "description": "Can capture pixels itself. If false the preview host captures.",
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/SourcePrecision",
          "description": "Level 3: best precision of source locations this adapter can report."
        },
        "tree": {
          "description": "Level 2: can produce a node tree with bounds.",
          "type": "boolean"
        }
      },
      "required": [
        "framework",
        "adapter",
        "tree",
        "hitTest",
        "properties",
        "accessibility",
        "source",
        "highlight",
        "screenshot",
        "mutations"
      ],
      "type": "object"
    },
    "Check": {
      "properties": {
        "actual": true,
        "expected": true,
        "kind": {
          "$ref": "#/$defs/CheckKind"
        },
        "passed": {
          "type": "boolean"
        },
        "summary": {
          "description": "Human-readable one-liner: what was expected and what was observed.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "passed",
        "summary"
      ],
      "type": "object"
    },
    "CheckKind": {
      "oneOf": [
        {
          "const": "buildClean",
          "description": "The build/reload finished without new error diagnostics.",
          "type": "string"
        },
        {
          "const": "runtimeClean",
          "description": "The app produced no new runtime errors after reload.",
          "type": "string"
        },
        {
          "const": "nodeReidentified",
          "description": "The selected node was found again via its stable key.",
          "type": "string"
        },
        {
          "const": "geometry",
          "description": "A geometric assertion on node bounds (the agent states these up\nfront, e.g. \"left edge of A equals left edge of B\").",
          "type": "string"
        },
        {
          "const": "pixelsChangedInRegion",
          "description": "Pixels changed inside the expected region.",
          "type": "string"
        },
        {
          "const": "pixelsStableElsewhere",
          "description": "Pixels did not change outside the expected region.",
          "type": "string"
        },
        {
          "const": "property",
          "description": "A property/computed-style assertion.",
          "type": "string"
        }
      ]
    },
    "Diagnostic": {
      "properties": {
        "code": {
          "description": "Tool-specific code, e.g. `E0308`, `-Wunused-variable`.",
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ],
          "description": "Primary location. Absent for diagnostics not tied to a file."
        },
        "message": {
          "description": "One-line message without location prefix.",
          "type": "string"
        },
        "related": {
          "default": [],
          "description": "Secondary locations (\"defined here\", notes).",
          "items": {
            "$ref": "#/$defs/RelatedInfo"
          },
          "type": "array"
        },
        "rendered": {
          "description": "The tool's own human-readable rendering, if it provides one.",
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "source": {
          "description": "Producing tool, e.g. `rustc`, `clang`, `tsc`.",
          "type": "string"
        }
      },
      "required": [
        "severity",
        "message",
        "source"
      ],
      "type": "object"
    },
    "DidMutateParams": {
      "properties": {
        "reason": {
          "$ref": "#/$defs/MutationReason",
          "description": "Coarse reason, for diagnostics only."
        }
      },
      "required": [
        "reason"
      ],
      "type": "object"
    },
    "Empty": {
      "type": "object"
    },
    "HelloParams": {
      "properties": {
        "protocolVersion": {
          "type": "string"
        },
        "token": {
          "description": "Session token issued by the daemon when the preview was launched.",
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "token"
      ],
      "type": "object"
    },
    "HighlightParams": {
      "properties": {
        "node": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "HitTestParams": {
      "properties": {
        "surface": {
          "type": "string"
        },
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "surface",
        "x",
        "y"
      ],
      "type": "object"
    },
    "HitTestResult": {
      "properties": {
        "chain": {
          "description": "`chain[0]` is the hit node; the rest are its ancestors up to the root.",
          "items": {
            "$ref": "#/$defs/UiNode"
          },
          "type": "array"
        }
      },
      "required": [
        "chain"
      ],
      "type": "object"
    },
    "Instance": {
      "properties": {
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "index": {
          "description": "0-based position among live nodes with the same primary source.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "index",
        "count"
      ],
      "type": "object"
    },
    "Location": {
      "description": "A span in a workspace file. Lines and columns are 1-based; columns count\nUnicode scalar values. `end` is exclusive and may be absent (point).",
      "properties": {
        "column": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "endColumn": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "endLine": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "file": {
          "$ref": "#/$defs/WorkspacePath"
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "file",
        "line"
      ],
      "type": "object"
    },
    "MappingMethod": {
      "description": "How a source location was obtained. Ordered from most to least reliable.",
      "oneOf": [
        {
          "const": "buildInstrumentation",
          "description": "Stamped at build time by Axiom instrumentation (E3: `data-axiom-src`).",
          "type": "string"
        },
        {
          "const": "runtimeMetadata",
          "description": "Recorded by the framework's own compiler/runtime (E2: QQmlData).",
          "type": "string"
        },
        {
          "const": "sourceMap",
          "description": "Derived through a source map from a generated location.",
          "type": "string"
        },
        {
          "const": "heuristic",
          "description": "Matched by name/text/structure search in the workspace.",
          "type": "string"
        },
        {
          "const": "visualInference",
          "description": "Inferred by a model from pixels. Always requires confirmation.",
          "type": "string"
        }
      ]
    },
    "MutationReason": {
      "enum": [
        "tree",
        "layout",
        "navigation",
        "hotReload"
      ],
      "type": "string"
    },
    "NodeId": {
      "description": "Node identity within one adapter connection. Valid until the node is\ndestroyed; never reused within a connection. Not stable across restarts.",
      "type": "string"
    },
    "NodeKind": {
      "oneOf": [
        {
          "enum": [
            "text"
          ],
          "type": "string"
        },
        {
          "const": "element",
          "description": "Renders pixels itself (DOM element, QQuickItem, View).",
          "type": "string"
        },
        {
          "const": "component",
          "description": "Logical grouping with no pixels of its own (React component).",
          "type": "string"
        }
      ]
    },
    "NodeRef": {
      "properties": {
        "node": {
          "$ref": "#/$defs/NodeId"
        }
      },
      "required": [
        "node"
      ],
      "type": "object"
    },
    "PeerInfo": {
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "Rect": {
      "properties": {
        "height": {
          "format": "double",
          "type": "number"
        },
        "width": {
          "format": "double",
          "type": "number"
        },
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "type": "object"
    },
    "RelatedInfo": {
      "properties": {
        "location": {
          "$ref": "#/$defs/Location"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "message",
        "location"
      ],
      "type": "object"
    },
    "Severity": {
      "enum": [
        "error",
        "warning",
        "info",
        "hint"
      ],
      "type": "string"
    },
    "Snapshot": {
      "properties": {
        "capturedMs": {
          "description": "Milliseconds since the Unix epoch, adapter clock.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "nodes": {
          "description": "Flat list, parents before children.",
          "items": {
            "$ref": "#/$defs/UiNode"
          },
          "type": "array"
        },
        "surfaces": {
          "items": {
            "$ref": "#/$defs/Surface"
          },
          "type": "array"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "capturedMs",
        "surfaces",
        "nodes",
        "truncated"
      ],
      "type": "object"
    },
    "SnapshotParams": {
      "properties": {
        "includeInvisible": {
          "default": false,
          "description": "Include nodes the framework considers invisible. Default false.",
          "type": "boolean"
        },
        "maxNodes": {
          "description": "Maximum number of nodes to return. Default 5000.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "root": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Limit to the subtree under this node; whole UI if absent."
        }
      },
      "type": "object"
    },
    "SourceCandidate": {
      "properties": {
        "confidence": {
          "description": "0.0..=1.0. Must not exceed `method.max_confidence()`.",
          "format": "float",
          "type": "number"
        },
        "generated": {
          "default": false,
          "description": "Location is in generated or third-party code (not a file the user\nwould edit). Such candidates are never auto-selected for patching.",
          "type": "boolean"
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "method": {
          "$ref": "#/$defs/MappingMethod"
        },
        "relation": {
          "$ref": "#/$defs/SourceRelation"
        }
      },
      "required": [
        "location",
        "relation",
        "method",
        "confidence"
      ],
      "type": "object"
    },
    "SourcePrecision": {
      "enum": [
        "none",
        "file",
        "line",
        "lineColumn"
      ],
      "type": "string"
    },
    "SourceRelation": {
      "oneOf": [
        {
          "const": "instantiation",
          "description": "Where this element is written (the JSX tag, the QML object literal).",
          "type": "string"
        },
        {
          "const": "definition",
          "description": "Where the component type of this element is defined.",
          "type": "string"
        },
        {
          "const": "owner",
          "description": "The component that rendered this element (owner).",
          "type": "string"
        },
        {
          "const": "style",
          "description": "A style rule affecting this element.",
          "type": "string"
        }
      ]
    },
    "Surface": {
      "description": "A top-level rendering target: a window, a browser page, an iframe, or an\nembedded foreign surface (e.g. a web view inside a native window).",
      "properties": {
        "devicePixelRatio": {
          "format": "double",
          "type": "number"
        },
        "height": {
          "format": "double",
          "type": "number"
        },
        "hostNode": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeId"
            },
            {
              "type": "null"
            }
          ],
          "description": "For nested surfaces: the node in the parent surface that hosts this one."
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SurfaceKind"
        },
        "scrollX": {
          "default": 0.0,
          "description": "Scroll offset of the surface's root scroller, logical pixels.",
          "format": "double",
          "type": "number"
        },
        "scrollY": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "description": "Visible size in logical pixels.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "id",
        "kind",
        "width",
        "height",
        "devicePixelRatio"
      ],
      "type": "object"
    },
    "SurfaceKind": {
      "enum": [
        "window",
        "page",
        "frame",
        "embedded"
      ],
      "type": "string"
    },
    "UiNode": {
      "description": "One element of the running UI.",
      "properties": {
        "accessibility": {
          "anyOf": [
            {
              "$ref": "#/$defs/Accessibility"
            },
            {
              "type": "null"
            }
          ]
        },
        "bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rect"
            },
            {
              "type": "null"
            }
          ],
          "description": "Axis-aligned bounding box. Absent for nodes that render nothing\n(pure components, `display: contents`)."
        },
        "children": {
          "default": [],
          "description": "Children in paint order (last is top-most).",
          "items": {
            "$ref": "#/$defs/NodeId"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/NodeId"
        },
        "instance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Instance"
            },
            {
              "type": "null"
            }
          ],
          "description": "Set when several live nodes share this node's primary source\nlocation (list items, repeated components)."
        },
        "kind": {
          "$ref": "#/$defs/NodeKind"
        },
        "name": {
          "description": "Developer-assigned identifier if any: DOM `id`, `data-testid`,\nQML `objectName`/`id`, accessibility identifier.",
          "type": [
            "string",
            "null"
          ]
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "properties": {
          "additionalProperties": true,
          "description": "Layout-relevant runtime properties, framework vocabulary preserved\n(CSS computed style subset, QML properties...). Only present in\n`inspect/nodeDetails` results.",
          "type": "object"
        },
        "sources": {
          "default": [],
          "description": "Candidate source locations, best first. Empty when unknown. More than\none entry means the mapping is ambiguous or multi-faceted; see\n[`SourceRelation`].",
          "items": {
            "$ref": "#/$defs/SourceCandidate"
          },
          "type": "array"
        },
        "stableKey": {
          "description": "Identity intended to survive a rebuild/reload of unchanged source: see\n`docs/protocols/inspection.md#stable-keys`. Absent if the adapter\ncannot compute one.",
          "type": [
            "string",
            "null"
          ]
        },
        "surface": {
          "type": "string"
        },
        "text": {
          "description": "Own rendered text, truncated to 200 characters.",
          "type": [
            "string",
            "null"
          ]
        },
        "typeName": {
          "description": "Framework type as the developer wrote it where possible: `button`,\n`BalanceCard`, `QQuickRectangle`.",
          "type": "string"
        },
        "visibility": {
          "$ref": "#/$defs/Visibility"
        }
      },
      "required": [
        "id",
        "surface",
        "typeName",
        "kind",
        "visibility"
      ],
      "type": "object"
    },
    "Verdict": {
      "oneOf": [
        {
          "const": "verified",
          "description": "Every check passed and at least one check directly tested the\nrequested outcome.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "At least one check failed.",
          "type": "string"
        },
        {
          "const": "inconclusive",
          "description": "Nothing failed, but the requested outcome could not be tested\nobjectively (e.g. the selected node could not be re-identified).",
          "type": "string"
        }
      ]
    },
    "VerificationReport": {
      "description": "Outcome of the before/after comparison in the closed-loop workflow.",
      "properties": {
        "changedFraction": {
          "description": "Fraction of pixels that differ, 0.0..=1.0.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "changedRegion": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rect"
            },
            {
              "type": "null"
            }
          ],
          "description": "Bounding box of changed pixels (logical px), if screenshots differ."
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/Check"
          },
          "type": "array"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "verdict",
        "checks"
      ],
      "type": "object"
    },
    "Visibility": {
      "properties": {
        "clipped": {
          "default": false,
          "description": "Part of the node lies outside the surface or an ancestor's clip.",
          "type": "boolean"
        },
        "occluded": {
          "description": "Whether another node paints over this one's centre point.\n`None` = not determined.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "visible": {
          "description": "The framework considers the node visible (not hidden, non-zero size,\nopacity > 0, attached).",
          "type": "boolean"
        }
      },
      "required": [
        "visible"
      ],
      "type": "object"
    },
    "WorkspacePath": {
      "description": "A path inside a workspace: relative to the workspace root, `/`-separated,\nUTF-8, with no `.`/`..` segments, no leading `/`, and no trailing `/`.\nThe workspace root itself is the empty string.\n\nClients never send absolute host paths except in `workspace/open`. The\ndaemon rejects any `WorkspacePath` that fails these rules with\n[`ErrorKind::InvalidParams`] and any that resolves (through symlinks)\noutside the root with [`ErrorKind::PermissionDenied`].",
      "type": "string"
    }
  },
  "diagnostic": {
    "$ref": "#/$defs/Diagnostic"
  },
  "methods": {
    "inspect/hello": {
      "params": {
        "$ref": "#/$defs/HelloParams"
      },
      "result": {
        "$ref": "#/$defs/Capabilities"
      }
    },
    "inspect/highlight": {
      "params": {
        "$ref": "#/$defs/HighlightParams"
      },
      "result": {
        "$ref": "#/$defs/Empty"
      }
    },
    "inspect/hitTest": {
      "params": {
        "$ref": "#/$defs/HitTestParams"
      },
      "result": {
        "$ref": "#/$defs/HitTestResult"
      }
    },
    "inspect/nodeDetails": {
      "params": {
        "$ref": "#/$defs/NodeRef"
      },
      "result": {
        "$ref": "#/$defs/UiNode"
      }
    },
    "inspect/snapshot": {
      "params": {
        "$ref": "#/$defs/SnapshotParams"
      },
      "result": {
        "$ref": "#/$defs/Snapshot"
      }
    }
  },
  "notifications": {
    "inspect/didMutate": {
      "params": {
        "$ref": "#/$defs/DidMutateParams"
      }
    }
  },
  "verificationReport": {
    "$ref": "#/$defs/VerificationReport"
  }
}
