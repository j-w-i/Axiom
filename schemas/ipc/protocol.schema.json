{
  "$comment": "GENERATED by `cargo run -p axiom-protocol --example export_schema`. Do not edit.",
  "$defs": {
    "CancelParams": {
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "ChangeKind": {
      "enum": [
        "created",
        "modified",
        "removed"
      ],
      "type": "string"
    },
    "Command": {
      "description": "What to run. `argv` is preferred: it involves no shell and no quoting.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Program and arguments, executed directly. `argv[0]` is resolved on\n`PATH`. Must be non-empty.",
          "properties": {
            "argv": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "argv"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A command line for the host's default shell (`sh -c` on Unix,\n`cmd /C` on Windows). For user-typed commands only.",
          "properties": {
            "shell": {
              "type": "string"
            }
          },
          "required": [
            "shell"
          ],
          "type": "object"
        }
      ]
    },
    "DidChangeParams": {
      "properties": {
        "changes": {
          "items": {
            "$ref": "#/$defs/FileChange"
          },
          "type": "array"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspaceId",
        "changes"
      ],
      "type": "object"
    },
    "DirEntry": {
      "properties": {
        "ignored": {
          "default": false,
          "description": "True if matched by `.gitignore`/`.ignore` rules or is `.git`. Ignored\nentries are still listed so the UI can dim them.",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/EntryKind"
        },
        "name": {
          "description": "Final path component only.",
          "type": "string"
        },
        "size": {
          "description": "Size in bytes; present for files only.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "type": "object"
    },
    "Empty": {
      "type": "object"
    },
    "EntryKind": {
      "oneOf": [
        {
          "enum": [
            "file",
            "directory"
          ],
          "type": "string"
        },
        {
          "const": "symlink",
          "description": "A symlink is reported as such and never followed by `fs/list`.",
          "type": "string"
        }
      ]
    },
    "ErrorData": {
      "properties": {
        "details": {
          "description": "Kind-specific structured detail (documented per method)."
        },
        "kind": {
          "$ref": "#/$defs/ErrorKind",
          "description": "Machine-readable category. Clients branch on this, never on `message`."
        },
        "retryable": {
          "default": false,
          "description": "Whether retrying the identical request may succeed.",
          "type": "boolean"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "ErrorKind": {
      "description": "Closed set of error categories. Unknown values received from a newer peer\ndeserialize as [`ErrorKind::Unknown`].",
      "enum": [
        "parse_error",
        "invalid_request",
        "method_not_found",
        "invalid_params",
        "internal",
        "not_initialized",
        "cancelled",
        "timeout",
        "unsupported",
        "not_found",
        "already_exists",
        "permission_denied",
        "conflict",
        "io",
        "unsupported_encoding",
        "too_large",
        "workspace_not_open",
        "spawn_failed",
        "unknown"
      ],
      "type": "string"
    },
    "ExitStatus": {
      "properties": {
        "durationMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "exitCode": {
          "description": "Process exit code; absent if the process was killed by a signal.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "signal": {
          "description": "Unix signal number that terminated the process, if any.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "outcome",
        "durationMs"
      ],
      "type": "object"
    },
    "ExitedParams": {
      "properties": {
        "durationMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "exitCode": {
          "description": "Process exit code; absent if the process was killed by a signal.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "signal": {
          "description": "Unix signal number that terminated the process, if any.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "taskId": {
          "$ref": "#/$defs/TaskId"
        }
      },
      "required": [
        "taskId",
        "outcome",
        "durationMs"
      ],
      "type": "object"
    },
    "FileChange": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/ChangeKind"
        },
        "path": {
          "$ref": "#/$defs/WorkspacePath"
        }
      },
      "required": [
        "path",
        "kind"
      ],
      "type": "object"
    },
    "FileVersion": {
      "description": "Opaque content fingerprint (lowercase hex SHA-256 of the file bytes).\nTwo reads return equal versions iff the bytes are equal.",
      "type": "string"
    },
    "GetParams": {
      "properties": {
        "keys": {
          "default": [],
          "description": "Keys to read; empty means all known and stored keys.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "GetResult": {
      "properties": {
        "values": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "values"
      ],
      "type": "object"
    },
    "GetStateParams": {
      "properties": {
        "keys": {
          "default": [],
          "description": "Keys to read; empty means all keys.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspaceId"
      ],
      "type": "object"
    },
    "HostInfo": {
      "properties": {
        "arch": {
          "description": "Rust target architecture string, e.g. `x86_64`, `aarch64`.",
          "type": "string"
        },
        "os": {
          "$ref": "#/$defs/HostOs"
        },
        "pathSeparator": {
          "description": "`/` or `\\`. For display only; the protocol itself always uses `/`.",
          "type": "string"
        }
      },
      "required": [
        "os",
        "arch",
        "pathSeparator"
      ],
      "type": "object"
    },
    "HostOs": {
      "enum": [
        "linux",
        "macos",
        "windows"
      ],
      "type": "string"
    },
    "InitializeParams": {
      "properties": {
        "client": {
          "$ref": "#/$defs/PeerInfo"
        },
        "protocolVersion": {
          "description": "Highest protocol version the client speaks, `MAJOR.MINOR`.",
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "client"
      ],
      "type": "object"
    },
    "InitializeResult": {
      "properties": {
        "host": {
          "$ref": "#/$defs/HostInfo"
        },
        "methods": {
          "description": "Wire names of every method this daemon build serves. Clients must\nfeature-detect with this list rather than by version number.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "protocolVersion": {
          "description": "Version the daemon will speak on this connection: same MAJOR as the\nclient, MINOR = min(client, daemon). A MAJOR mismatch is an\n`unsupported` error instead.",
          "type": "string"
        },
        "server": {
          "$ref": "#/$defs/PeerInfo"
        }
      },
      "required": [
        "protocolVersion",
        "server",
        "methods",
        "host"
      ],
      "type": "object"
    },
    "JsonRpcVersion": {
      "description": "The literal string `\"2.0\"`.",
      "enum": [
        "2.0"
      ],
      "type": "string"
    },
    "ListParams": {
      "properties": {
        "path": {
          "$ref": "#/$defs/WorkspacePath"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspaceId",
        "path"
      ],
      "type": "object"
    },
    "ListResult": {
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/DirEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "entries"
      ],
      "type": "object"
    },
    "ListTasksParams": {
      "properties": {
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspaceId"
      ],
      "type": "object"
    },
    "ListTasksResult": {
      "properties": {
        "tasks": {
          "items": {
            "$ref": "#/$defs/TaskInfo"
          },
          "type": "array"
        }
      },
      "required": [
        "tasks"
      ],
      "type": "object"
    },
    "LogLevel": {
      "enum": [
        "error",
        "warn",
        "info",
        "debug"
      ],
      "type": "string"
    },
    "LogParams": {
      "properties": {
        "level": {
          "$ref": "#/$defs/LogLevel"
        },
        "message": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "level",
        "target",
        "message"
      ],
      "type": "object"
    },
    "Message": {
      "anyOf": [
        {
          "$ref": "#/$defs/Request"
        },
        {
          "$ref": "#/$defs/Response"
        },
        {
          "$ref": "#/$defs/Notification"
        }
      ],
      "description": "Any message that can appear on the wire, in either direction.\n\nClassification on receipt: an object with `method` and `id` is a request;\nwith `method` and no `id`, a notification; otherwise a response."
    },
    "Notification": {
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "method": {
          "type": "string"
        },
        "params": true
      },
      "required": [
        "jsonrpc",
        "method"
      ],
      "type": "object"
    },
    "OpenParams": {
      "properties": {
        "path": {
          "description": "Absolute host path in host-native form.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "OpenResult": {
      "properties": {
        "name": {
          "description": "Display name: the final component of `root`.",
          "type": "string"
        },
        "root": {
          "description": "Canonical absolute root (symlinks resolved), host-native form.",
          "type": "string"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspaceId",
        "root",
        "name"
      ],
      "type": "object"
    },
    "Outcome": {
      "oneOf": [
        {
          "const": "succeeded",
          "description": "Exit code 0.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Non-zero exit code, or killed by a signal Axiom did not send.",
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "Terminated because of `task/cancel`, workspace close, or shutdown.",
          "type": "string"
        }
      ]
    },
    "OutputParams": {
      "properties": {
        "data": {
          "type": "string"
        },
        "seq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "stream": {
          "$ref": "#/$defs/Stream"
        },
        "taskId": {
          "$ref": "#/$defs/TaskId"
        }
      },
      "required": [
        "taskId",
        "seq",
        "stream",
        "data"
      ],
      "type": "object"
    },
    "PeerInfo": {
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "ReadFileParams": {
      "properties": {
        "path": {
          "$ref": "#/$defs/WorkspacePath"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspaceId",
        "path"
      ],
      "type": "object"
    },
    "ReadFileResult": {
      "properties": {
        "text": {
          "description": "File content exactly as on disk, including its line endings.",
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/FileVersion"
        }
      },
      "required": [
        "text",
        "version"
      ],
      "type": "object"
    },
    "RecentResult": {
      "properties": {
        "workspaces": {
          "items": {
            "$ref": "#/$defs/RecentWorkspace"
          },
          "type": "array"
        }
      },
      "required": [
        "workspaces"
      ],
      "type": "object"
    },
    "RecentWorkspace": {
      "properties": {
        "lastOpenedMs": {
          "description": "Milliseconds since the Unix epoch.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "root": {
          "type": "string"
        }
      },
      "required": [
        "root",
        "name",
        "lastOpenedMs"
      ],
      "type": "object"
    },
    "Request": {
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "method": {
          "type": "string"
        },
        "params": true
      },
      "required": [
        "jsonrpc",
        "id",
        "method"
      ],
      "type": "object"
    },
    "RequestId": {
      "anyOf": [
        {
          "format": "int64",
          "type": "integer"
        },
        {
          "type": "string"
        }
      ],
      "description": "Request correlation id. Clients choose ids; they must be unique among that\nclient's in-flight requests on one connection."
    },
    "Response": {
      "description": "Exactly one of `result` / `error` is present.",
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/RpcError"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestId"
            },
            {
              "type": "null"
            }
          ],
          "description": "`null` only when the request id could not be read (parse error)."
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "result": true
      },
      "required": [
        "jsonrpc"
      ],
      "type": "object"
    },
    "RpcError": {
      "properties": {
        "code": {
          "description": "Numeric code; always equals `data.kind.code()`.",
          "format": "int32",
          "type": "integer"
        },
        "data": {
          "$ref": "#/$defs/ErrorData"
        },
        "message": {
          "description": "Human-readable, single sentence, safe to show to a user.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "type": "object"
    },
    "SetParams": {
      "properties": {
        "values": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "values"
      ],
      "type": "object"
    },
    "SetStateParams": {
      "properties": {
        "values": {
          "additionalProperties": true,
          "type": "object"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspaceId",
        "values"
      ],
      "type": "object"
    },
    "StartParams": {
      "properties": {
        "command": {
          "$ref": "#/$defs/Command"
        },
        "cwd": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkspacePath"
            },
            {
              "type": "null"
            }
          ],
          "description": "Working directory; defaults to the workspace root."
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Variables added to (or overriding) the daemon's environment.",
          "type": "object"
        },
        "label": {
          "description": "Display label; defaults to the command line.",
          "type": [
            "string",
            "null"
          ]
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspaceId",
        "command"
      ],
      "type": "object"
    },
    "StartResult": {
      "properties": {
        "taskId": {
          "$ref": "#/$defs/TaskId"
        }
      },
      "required": [
        "taskId"
      ],
      "type": "object"
    },
    "StateResult": {
      "properties": {
        "values": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "values"
      ],
      "type": "object"
    },
    "Stream": {
      "enum": [
        "stdout",
        "stderr"
      ],
      "type": "string"
    },
    "TaskId": {
      "description": "Opaque identifier of a running or finished task, minted by `task/start`.",
      "type": "string"
    },
    "TaskInfo": {
      "properties": {
        "command": {
          "$ref": "#/$defs/Command"
        },
        "exit": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExitStatus"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent while the task is running."
        },
        "label": {
          "type": "string"
        },
        "startedMs": {
          "description": "Milliseconds since the Unix epoch.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "taskId": {
          "$ref": "#/$defs/TaskId"
        }
      },
      "required": [
        "taskId",
        "label",
        "command",
        "startedMs"
      ],
      "type": "object"
    },
    "TaskRef": {
      "properties": {
        "taskId": {
          "$ref": "#/$defs/TaskId"
        }
      },
      "required": [
        "taskId"
      ],
      "type": "object"
    },
    "WatchParams": {
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspaceId",
        "enabled"
      ],
      "type": "object"
    },
    "WorkspaceId": {
      "description": "Opaque identifier of an open workspace, minted by `workspace/open`.",
      "type": "string"
    },
    "WorkspacePath": {
      "description": "A path inside a workspace: relative to the workspace root, `/`-separated,\nUTF-8, with no `.`/`..` segments, no leading `/`, and no trailing `/`.\nThe workspace root itself is the empty string.\n\nClients never send absolute host paths except in `workspace/open`. The\ndaemon rejects any `WorkspacePath` that fails these rules with\n[`ErrorKind::InvalidParams`] and any that resolves (through symlinks)\noutside the root with [`ErrorKind::PermissionDenied`].",
      "type": "string"
    },
    "WorkspaceRef": {
      "properties": {
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspaceId"
      ],
      "type": "object"
    },
    "WriteFileParams": {
      "properties": {
        "expectedVersion": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileVersion"
            },
            {
              "type": "null"
            }
          ],
          "description": "Version the client last read. If set, the write is refused with\n`conflict` unless the file on disk still has this version. Omit to\ncreate a new file (fails with `conflict` if the file exists) —\nset [`WriteFileParams::overwrite`] to bypass both checks."
        },
        "overwrite": {
          "default": false,
          "description": "Write unconditionally. Used for \"overwrite anyway\" after a conflict.",
          "type": "boolean"
        },
        "path": {
          "$ref": "#/$defs/WorkspacePath"
        },
        "text": {
          "type": "string"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspaceId",
        "path",
        "text"
      ],
      "type": "object"
    },
    "WriteFileResult": {
      "properties": {
        "version": {
          "$ref": "#/$defs/FileVersion"
        }
      },
      "required": [
        "version"
      ],
      "type": "object"
    }
  },
  "envelope": {
    "$ref": "#/$defs/Message"
  },
  "methods": {
    "fs/list": {
      "params": {
        "$ref": "#/$defs/ListParams"
      },
      "result": {
        "$ref": "#/$defs/ListResult"
      }
    },
    "fs/readFile": {
      "params": {
        "$ref": "#/$defs/ReadFileParams"
      },
      "result": {
        "$ref": "#/$defs/ReadFileResult"
      }
    },
    "fs/watch": {
      "params": {
        "$ref": "#/$defs/WatchParams"
      },
      "result": {
        "$ref": "#/$defs/Empty"
      }
    },
    "fs/writeFile": {
      "params": {
        "$ref": "#/$defs/WriteFileParams"
      },
      "result": {
        "$ref": "#/$defs/WriteFileResult"
      }
    },
    "initialize": {
      "params": {
        "$ref": "#/$defs/InitializeParams"
      },
      "result": {
        "$ref": "#/$defs/InitializeResult"
      }
    },
    "settings/get": {
      "params": {
        "$ref": "#/$defs/GetParams"
      },
      "result": {
        "$ref": "#/$defs/GetResult"
      }
    },
    "settings/set": {
      "params": {
        "$ref": "#/$defs/SetParams"
      },
      "result": {
        "$ref": "#/$defs/Empty"
      }
