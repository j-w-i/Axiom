{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The only window. Grants the shell's own commands and a folder picker; nothing that touches workspace files, processes or arbitrary URLs.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:app:allow-version",
    "allow-host-subscribe",
    "allow-daemon-request",
    "allow-daemon-cancel",
    "allow-daemon-restart",
    "allow-app-info",
    "allow-open-external",
    "allow-app-quit",
    "allow-host-heartbeat",
    "allow-snapshot-put",
    "allow-snapshot-clear",
    "allow-recovery-state",
    "core:event:allow-listen",
    "dialog:allow-open"
  ]
}
