{
  "$comment": "GENERATED by `cargo run -p axiom-protocol --example export_schema`. Do not edit.",
  "$defs": {
    "ArchiveFormat": {
      "oneOf": [
        {
          "enum": [
            "tar.gz",
            "tar.xz",
            "zip"
          ],
          "type": "string"
        },
        {
          "const": "file",
          "description": "The download is the file itself (a single executable, e.g. `rustup-init`), placed at\nthe root under its URL's last path segment, executable. Added in M2-ENV-003.",
          "type": "string"
        }
      ]
    },
    "BuildDiagnostics": {
      "properties": {
        "complete": {
          "description": "No more diagnostics follow for this task.",
          "type": "boolean"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "type": "array"
        },
        "taskId": {
          "$ref": "#/$defs/TaskId"
        }
      },
      "required": [
        "taskId",
        "diagnostics",
        "complete"
      ],
      "type": "object"
    },
    "CancelParams": {
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "ChangeKind": {
      "enum": [
        "created",
        "modified",
        "removed"
      ],
      "type": "string"
    },
    "Command": {
      "description": "What to run. `argv` is preferred: it involves no shell and no quoting.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Program and arguments, executed directly. `argv[0]` is resolved on\n`PATH`. Must be non-empty.",
          "properties": {
            "argv": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "argv"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A command line for the host's default shell (`sh -c` on Unix,\n`cmd /C` on Windows). For user-typed commands only.",
          "properties": {
            "shell": {
              "type": "string"
            }
          },
          "required": [
            "shell"
          ],
          "type": "object"
        }
      ]
    },
    "DetectResult": {
      "properties": {
        "providers": {
          "description": "The providers whose project detection matched, in registry order.",
          "items": {
            "$ref": "#/$defs/ProviderDetection"
          },
          "type": "array"
        }
      },
      "required": [
        "providers"
      ],
      "type": "object"
    },
    "Diagnostic": {
      "properties": {
        "code": {
          "description": "Tool-specific code, e.g. `E0308`, `-Wunused-variable`.",
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ],
          "description": "Primary location. Absent for diagnostics not tied to a file."
        },
        "message": {
          "description": "One-line message without location prefix.",
          "type": "string"
        },
        "related": {
          "default": [],
          "description": "Secondary locations (\"defined here\", notes).",
          "items": {
            "$ref": "#/$defs/RelatedInfo"
          },
          "type": "array"
        },
        "rendered": {
          "description": "The tool's own human-readable rendering, if it provides one.",
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "source": {
          "description": "Producing tool, e.g. `rustc`, `clang`, `tsc`.",
          "type": "string"
        }
      },
      "required": [
        "severity",
        "message",
        "source"
      ],
      "type": "object"
    },
    "DidChangeParams": {
      "properties": {
        "changes": {
          "items": {
            "$ref": "#/$defs/FileChange"
          },
          "type": "array"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspaceId",
        "changes"
      ],
      "type": "object"
    },
    "DirEntry": {
      "properties": {
        "ignored": {
          "default": false,
          "description": "True if matched by `.gitignore`/`.ignore` rules or is `.git`. Ignored\nentries are still listed so the UI can dim them.",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/EntryKind"
        },
        "name": {
          "description": "Final path component only.",
          "type": "string"
        },
        "size": {
          "description": "Size in bytes; present for files only.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "type": "object"
    },
    "Effect": {
      "oneOf": [
        {
          "const": "network",
          "description": "Downloads from the network.",
          "type": "string"
        },
        {
          "const": "writeManaged",
          "description": "Writes under Axiom's managed storage only.",
          "type": "string"
        },
        {
          "const": "runPrograms",
          "description": "Runs programs the plan lists.",
          "type": "string"
        },
        {
          "const": "systemChange",
          "description": "Changes the machine outside Axiom's storage (system packages).",
          "type": "string"
        },
        {
          "const": "elevation",
          "description": "Needs the OS elevation prompt.",
          "type": "string"
        }
      ]
    },
    "Empty": {
      "type": "object"
    },
    "EntryKind": {
      "oneOf": [
        {
          "enum": [
            "file",
            "directory"
          ],
          "type": "string"
        },
        {
          "const": "symlink",
          "description": "A symlink is reported as such and never followed by `fs/list`.",
          "type": "string"
        }
      ]
    },
    "Environment": {
      "description": "What a process started for the project runs with.",
      "properties": {
        "pathPrepend": {
          "description": "Directories (host paths) put in front of `PATH`, in order.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "toolchains": {
          "items": {
            "$ref": "#/$defs/Toolchain"
          },
          "type": "array"
        },
        "vars": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Variables set for the process.",
          "type": "object"
        }
      },
      "required": [
        "toolchains",
        "pathPrepend",
        "vars"
      ],
      "type": "object"
    },
    "ErrorData": {
      "properties": {
        "details": {
          "description": "Kind-specific structured detail (documented per method)."
        },
        "kind": {
          "$ref": "#/$defs/ErrorKind",
          "description": "Machine-readable category. Clients branch on this, never on `message`."
        },
        "retryable": {
          "default": false,
          "description": "Whether retrying the identical request may succeed.",
          "type": "boolean"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "ErrorKind": {
      "description": "Closed set of error categories. Unknown values received from a newer peer\ndeserialize as [`ErrorKind::Unknown`].",
      "oneOf": [
        {
          "enum": [
            "parse_error",
            "invalid_request",
            "method_not_found",
            "invalid_params",
            "internal",
            "not_initialized",
            "cancelled",
            "timeout",
            "unsupported",
            "not_found",
            "already_exists",
            "permission_denied",
            "conflict",
            "io",
            "unsupported_encoding",
            "too_large",
            "workspace_not_open",
            "spawn_failed",
            "checksum_mismatch",
            "unsupported_platform",
            "approval_denied",
            "unknown"
          ],
          "type": "string"
        },
        {
          "const": "prerequisite_missing",
          "description": "Details: `{ \"missing\": [toolId] }`.",
          "type": "string"
        }
      ]
    },
    "ExitStatus": {
      "properties": {
        "durationMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "exitCode": {
          "description": "Process exit code; absent if the process was killed by a signal.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "signal": {
          "description": "Unix signal number that terminated the process, if any.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "outcome",
        "durationMs"
      ],
      "type": "object"
    },
    "ExitedParams": {
      "properties": {
        "durationMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "exitCode": {
          "description": "Process exit code; absent if the process was killed by a signal.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "signal": {
          "description": "Unix signal number that terminated the process, if any.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "taskId": {
          "$ref": "#/$defs/TaskId"
        }
      },
      "required": [
        "taskId",
        "outcome",
        "durationMs"
      ],
      "type": "object"
    },
    "FileChange": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/ChangeKind"
        },
        "path": {
          "$ref": "#/$defs/WorkspacePath"
        }
      },
      "required": [
        "path",
        "kind"
      ],
      "type": "object"
    },
    "FileVersion": {
      "description": "Opaque content fingerprint (lowercase hex SHA-256 of the file bytes).\nTwo reads return equal versions iff the bytes are equal.",
      "type": "string"
    },
    "GetParams": {
      "properties": {
        "keys": {
          "default": [],
          "description": "Keys to read; empty means all known and stored keys.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "GetResult": {
      "properties": {
        "values": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "values"
      ],
      "type": "object"
    },
    "GetStateParams": {
      "properties": {
        "keys": {
          "default": [],
          "description": "Keys to read; empty means all keys.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspaceId"
      ],
      "type": "object"
    },
    "HostInfo": {
      "properties": {
        "arch": {
          "description": "Rust target architecture string, e.g. `x86_64`, `aarch64`.",
          "type": "string"
        },
        "os": {
          "$ref": "#/$defs/HostOs"
        },
        "pathSeparator": {
          "description": "`/` or `\\`. For display only; the protocol itself always uses `/`.",
          "type": "string"
        }
      },
      "required": [
        "os",
        "arch",
        "pathSeparator"
      ],
      "type": "object"
    },
    "HostOs": {
      "enum": [
        "linux",
        "macos",
        "windows"
      ],
      "type": "string"
    },
    "InitializeParams": {
      "properties": {
        "client": {
          "$ref": "#/$defs/PeerInfo"
        },
        "protocolVersion": {
          "description": "Highest protocol version the client speaks, `MAJOR.MINOR`.",
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "client"
      ],
      "type": "object"
    },
    "InitializeResult": {
      "properties": {
        "host": {
          "$ref": "#/$defs/HostInfo"
        },
        "methods": {
          "description": "Wire names of every method this daemon build serves. Clients must\nfeature-detect with this list rather than by version number.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "protocolVersion": {
          "description": "Version the daemon will speak on this connection: same MAJOR as the\nclient, MINOR = min(client, daemon). A MAJOR mismatch is an\n`unsupported` error instead.",
          "type": "string"
        },
        "server": {
          "$ref": "#/$defs/PeerInfo"
        }
      },
      "required": [
        "protocolVersion",
        "server",
        "methods",
        "host"
      ],
      "type": "object"
    },
    "InstallParams": {
      "properties": {
        "planId": {
          "type": "string"
        }
      },
      "required": [
        "planId"
      ],
      "type": "object"
    },
    "InstallPlan": {
      "description": "Everything an install will do, shown to the user before anything runs. Immutable.",
      "properties": {
        "downloadBytes": {
          "description": "Total download size when every download's size is known.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "effects": {
          "description": "What the plan will do to the machine, for the approval summary.",
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "type": "array"
        },
        "expiresMs": {
          "description": "The plan expires at this time (Unix ms); `env/install` refuses it afterwards.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "planId": {
          "type": "string"
        },
        "providerId": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/InstallScope"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "planId",
        "providerId",
        "version",
        "scope",
        "steps",
        "effects",
        "expiresMs"
      ],
      "type": "object"
    },
    "InstallProgress": {
      "properties": {
        "bytesDone": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "bytesTotal": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "label": {
          "description": "Human-readable current activity, e.g. \"Verifying SHA-256\".",
          "type": "string"
        },
        "planId": {
          "type": "string"
        },
        "step": {
          "description": "0-based index of the current step in `InstallPlan.steps`.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "steps": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "planId",
        "step",
        "steps",
        "label"
      ],
      "type": "object"
    },
    "InstallResult": {
      "properties": {
        "planId": {
          "type": "string"
        },
        "providerId": {
          "type": "string"
        },
        "root": {
          "description": "The published install root (managed installs).",
          "type": [
            "string",
            "null"
          ]
        },
        "verified": {
          "description": "The tools verified after the install.",
          "items": {
            "$ref": "#/$defs/Toolchain"
          },
          "type": "array"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "planId",
        "providerId",
        "version",
        "verified"
      ],
      "type": "object"
    },
    "InstallScope": {
      "oneOf": [
        {
          "const": "managed",
          "description": "Under Axiom's data directory; removable without side effects.",
          "type": "string"
        },
        {
          "const": "system",
          "description": "Modifies the user's or machine's global state.",
          "type": "string"
        }
      ]
    },
    "JsonRpcVersion": {
      "description": "The literal string `\"2.0\"`.",
      "enum": [
        "2.0"
      ],
      "type": "string"
    },
    "ListParams": {
      "properties": {
        "path": {
          "$ref": "#/$defs/WorkspacePath"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspaceId",
        "path"
      ],
      "type": "object"
    },
    "ListResult": {
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/DirEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "entries"
      ],
      "type": "object"
    },
    "ListTasksParams": {
      "properties": {
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspaceId"
      ],
      "type": "object"
    },
    "ListTasksResult": {
      "properties": {
        "tasks": {
          "items": {
            "$ref": "#/$defs/TaskInfo"
          },
          "type": "array"
        }
      },
      "required": [
        "tasks"
      ],
      "type": "object"
    },
    "Location": {
      "description": "A span in a workspace file. Lines and columns are 1-based; columns count\nUnicode scalar values. `end` is exclusive and may be absent (point).",
      "properties": {
        "column": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "endColumn": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "endLine": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "file": {
          "$ref": "#/$defs/WorkspacePath"
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "file",
        "line"
      ],
      "type": "object"
    },
    "LogLevel": {
      "enum": [
        "error",
        "warn",
        "info",
        "debug"
      ],
      "type": "string"
    },
    "LogParams": {
      "properties": {
        "level": {
          "$ref": "#/$defs/LogLevel"
        },
        "message": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "level",
        "target",
        "message"
      ],
      "type": "object"
    },
    "Message": {
      "anyOf": [
        {
          "$ref": "#/$defs/Request"
        },
        {
          "$ref": "#/$defs/Response"
        },
        {
          "$ref": "#/$defs/Notification"
        }
      ],
      "description": "Any message that can appear on the wire, in either direction.\n\nClassification on receipt: an object with `method` and `id` is a request;\nwith `method` and no `id`, a notification; otherwise a response."
    },
    "Notification": {
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "method": {
          "type": "string"
        },
        "params": true
      },
      "required": [
        "jsonrpc",
        "method"
      ],
      "type": "object"
    },
    "OpenParams": {
      "properties": {
        "path": {
          "description": "Absolute host path in host-native form.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "OpenResult": {
      "properties": {
        "name": {
          "description": "Display name: the final component of `root`.",
          "type": "string"
        },
        "root": {
          "description": "Canonical absolute root (symlinks resolved), host-native form.",
          "type": "string"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspaceId",
        "root",
        "name"
      ],
      "type": "object"
    },
    "Outcome": {
      "oneOf": [
        {
          "const": "succeeded",
          "description": "Exit code 0.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Non-zero exit code, or killed by a signal Axiom did not send.",
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "Terminated because of `task/cancel`, workspace close, or shutdown.",
          "type": "string"
        }
      ]
    },
    "OutputParams": {
      "properties": {
        "data": {
          "type": "string"
        },
        "seq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "stream": {
          "$ref": "#/$defs/Stream"
        },
        "taskId": {
          "$ref": "#/$defs/TaskId"
        }
      },
      "required": [
        "taskId",
        "seq",
        "stream",
        "data"
      ],
      "type": "object"
    },
    "PeerInfo": {
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "PlanInstallParams": {
      "properties": {
        "method": {
          "description": "Index into the manifest's `install` methods; absent = the first one usable on this host.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "providerId": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "providerId",
        "version"
      ],
      "type": "object"
    },
    "ProviderDetection": {
      "properties": {
        "providerId": {
          "type": "string"
        },
        "selectedVersion": {
          "description": "The version `.axiom/project.toml` selects for this provider, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/ToolStatus"
          },
          "type": "array"
        }
      },
      "required": [
        "providerId",
        "tools"
      ],
      "type": "object"
    },
    "ProviderInfo": {
      "properties": {
        "description": {
          "type": "string"
        },
        "errors": {
          "description": "Why the provider cannot be used (manifest validation errors). A provider with errors\nis never loaded; for a manifest that did not parse, `id` is its directory name.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ProviderSource"
        },
        "trusted": {
